# Use a strong URL-safe password (letters/digits recommended for the connection URL).
POSTGRES_PASSWORD=change_me_to_a_strong_password
# Local development connects through the localhost port in the README docker run command.
DATABASE_URL=postgresql+psycopg://workflow:change_me_to_a_strong_password@127.0.0.1:5432/workflow
HICODE_API_KEY=
HICODE_BASE_URL=https://api.hi-code.cc/v1
HICODE_IMAGE_MODEL=gpt-image-2
HICODE_IMAGE_SIZE=2048x1152
HICODE_REQUEST_TIMEOUT=300
HICODE_MAX_PROJECT_SHOTS=200
HICODE_VERIFY_SSL=true
HICODE_USE_ENV_PROXY=false
# Optional: comma-separated origins for a separately hosted frontend.
CORS_ORIGINS=
# Disable public registration on private deployments.
ALLOW_REGISTRATION=true
# Set true when serving through HTTPS (false for localhost HTTP).
COOKIE_SECURE=false
# Optional Fernet key; leave blank to persist an automatically generated key file.
# Keep the same key across restarts/replicas; never commit the real key.
PHOTODREAM_ENCRYPTION_KEY=
# Optional key file path; default: WORKFLOW_RUNTIME_DIR/secrets/api-keys.key.
PHOTODREAM_ENCRYPTION_KEY_FILE=
